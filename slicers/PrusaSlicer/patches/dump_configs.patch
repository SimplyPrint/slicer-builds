+static void append_profile(
+    std::vector<AccumulatedProfile>& profiles,
+    std::map<std::string, size_t>& indices,
+    const std::string& vendor_id,
+    const std::string& native_id,
+    const std::string& root_id,
+    const std::string& name,
+    const std::string& technology,
+    const Domain::ConfigBox& config,
+    nlohmann::ordered_json context
+)
+{
+    nlohmann::ordered_json data = config;
+    const std::string key = vendor_id + "\n" + native_id + "\n" + data.dump();
+    auto [it, inserted] = indices.emplace(key, profiles.size());
+    if (inserted) {
+        profiles.push_back({
+            .profile = {
+                {"vendor_id", vendor_id},
+                {"native_id", native_id},
+                {"root_id", root_id},
+                {"name", name},
+                {"technology", technology},
+                {"data", std::move(data)},
+                {"contexts", nlohmann::ordered_json::array()},
+            },
+        });
+    }
+
+    AccumulatedProfile& profile = profiles[it->second];
+    if (profile.context_keys.insert(context.dump()).second)
+        profile.profile["contexts"].push_back(std::move(context));
+}
+
+static nlohmann::ordered_json finish_profiles(std::vector<AccumulatedProfile>& profiles)
+{
+    nlohmann::ordered_json result = nlohmann::ordered_json::array();
+    for (AccumulatedProfile& profile : profiles)
+        result.push_back(std::move(profile.profile));
+    return result;
+}
+
+static void dump_profile_bundle(const Bundle& bundle, const fs::path& output_path)
+{
+    std::vector<AccumulatedProfile> machines;
+    std::vector<AccumulatedProfile> processes;
+    std::vector<AccumulatedProfile> filaments;
+    std::map<std::string, size_t> machine_indices;
+    std::map<std::string, size_t> process_indices;
+    std::map<std::string, size_t> filament_indices;
+
+    for (const auto& [hardware_id, printer_variants] : bundle.evaluated_presets) {
+        for (const Domain::Preset::EvaluatedPrinterPreset& printer : printer_variants) {
+            const std::string technology =
+                printer.technology() == PrinterTechnology::FFF ? "FFF" : "SLA";
+            nlohmann::ordered_json machine_context{
+                {"hardware_id", hardware_id},
+                {"printer_preset_id", printer.preset.id},
+                {"printer_model", printer.hw_config.model.model},
+                {"printer_base_model", printer.hw_config.model.base_model},
+                {"tool_count", printer.hw_config.tool_count},
+            };
+            nlohmann::ordered_json machine_preset = Domain::Preset::SelectedPresetMetadata{
+                .hw_config = printer.hw_config,
+                .printer = printer.preset.metadata(),
+            };
+            machine_preset["printer"]["conditions"].clear();
+            machine_context["preset"] = {
+                {"hw_config", machine_preset["hw_config"]},
+                {"printer", machine_preset["printer"]},
+            };
+            append_profile(
+                machines,
+                machine_indices,
+                printer.hw_config.vendor_id,
+                hardware_id + ":" + printer.preset.id,
+                printer.preset.root_id,
+                printer.hw_config.name,
+                technology,
+                printer.preset.config_box(),
+                std::move(machine_context)
+            );
+
+            for (const Domain::Preset::EvaluatedPrintPreset& print : printer.prints) {
+                nlohmann::ordered_json print_context{
+                    {"machine_id", hardware_id + ":" + printer.preset.id},
+                    {"machine_name", printer.hw_config.name},
+                    {"tool_processes", nlohmann::ordered_json::array()},
+                };
+                nlohmann::ordered_json print_preset = Domain::Preset::SelectedPresetMetadata{
+                    .print = print.preset.metadata(),
+                };
+                print_preset["print"]["conditions"].clear();
+                print_context["preset"] = print_preset["print"];
+
+                for (size_t tool = 0; tool < print.tools.size(); ++tool) {
+                    for (const Domain::Preset::EvaluatedToolPrintPreset& tool_print : print.tools[tool]) {
+                        nlohmann::ordered_json tool_preset = Domain::Preset::SelectedPresetMetadata{
+                            .tools = {tool_print.preset.metadata()},
+                        };
+                        tool_preset["tools"][0]["conditions"].clear();
+                        print_context["tool_processes"].push_back({
+                            {"tool", tool},
+                            {"native_id", tool_print.preset.id},
+                            {"root_id", tool_print.preset.root_id},
+                            {"name", tool_print.preset.name},
+                            {"data", tool_print.preset.config_box()},
+                            {"preset", tool_preset["tools"][0]},
+                        });
+                    }
+                }
+
+                append_profile(
+                    processes,
+                    process_indices,
+                    printer.hw_config.vendor_id,
+                    print.preset.id,
+                    print.preset.root_id,
+                    print.preset.name,
+                    technology,
+                    print.preset.config_box(),
+                    std::move(print_context)
+                );
+
+                for (size_t tool = 0; tool < print.materials.size(); ++tool) {
+                    for (const Domain::Preset::EvaluatedMaterialPreset& material : print.materials[tool]) {
+                        nlohmann::ordered_json material_preset = Domain::Preset::SelectedPresetMetadata{
+                            .materials = {material.preset.metadata()},
+                        };
+                        material_preset["materials"][0]["conditions"].clear();
+                        nlohmann::ordered_json material_context{
+                            {"machine_id", hardware_id + ":" + printer.preset.id},
+                            {"machine_name", printer.hw_config.name},
+                            {"preset", material_preset["materials"][0]},
+                        };
+                        append_profile(
+                            filaments,
+                            filament_indices,
+                            printer.hw_config.vendor_id,
+                            material.preset.id,
+                            material.preset.root_id,
+                            material.preset.name,
+                            technology,
+                            material.preset.config_box(),
+                            std::move(material_context)
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    nlohmann::ordered_json output{
+        {"schema_version", 1},
+        {"format", "prusa-evaluated-profiles"},
+        {"slicer_version", Slic3r::VERSION},
+        {"machine", finish_profiles(machines)},
+        {"process", finish_profiles(processes)},
+        {"filament", finish_profiles(filaments)},
+    };
+
+    boost::nowide::ofstream output_file(output_path.string());
+    if (!output_file.is_open())
+        throw std::runtime_error("Cannot open profile bundle output: " + output_path.string());
+    output_file << output.dump(2) << std::endl;
+}
+
+static void perform_config_model_dump(CLIRuntime& runtime, const MiscParams& misc)
+{
+    const fs::path model_path = misc.config_model_json_file.value_or("config-model.json");
+    dump_config_model(model_path.string());
+    dump_profile_bundle(
+        runtime.project_interactor().workbench().preset_bundle(),
+        model_path.parent_path() / "profile-bundle.json"
+    );
 }
 
