@@ -3,6 +3,7 @@
 #include "GLShadersManager.hpp"
 #include "3DScene.hpp"
 #include "GUI_App.hpp"
+#include "OpenGLManager.hpp"
 
 #include <cassert>
 #include <algorithm>
@@ -44,7 +45,7 @@ std::pair<bool, std::string> GLShadersManager::init()
 
     bool valid = true;
 
