diff --git a/src/libslic3r/PrintConfig.cpp b/src/libslic3r/PrintConfig.cpp
--- a/src/libslic3r/PrintConfig.cpp
+++ b/src/libslic3r/PrintConfig.cpp
@@ -12690,6 +12690,13 @@
         default:;
         }
         if (out_of_range) {
+            // The GUI only warns about out-of-range values and slices anyway; shipped
+            // profiles rely on that (Kobra S1 Max retraction_distances_when_cut = 0).
+            if (under_cli) {
+                BOOST_LOG_TRIVIAL(warning) << "Out-of-range value, slicing anyway: " << opt_key << " = " << opt->serialize()
+                                           << " not in range [" << optdef->min << "," << optdef->max << "]";
+                continue;
+            }
             if (error_message.find(opt_key) == error_message.end())
                 // TRN %1% is the current value, %2% and %3% the lowest and highest allowed values.
                 error_message.emplace(opt_key, Slic3r::format(_u8L("%1% not in range [%2%, %3%]"), opt->serialize(), optdef->min, optdef->max));
