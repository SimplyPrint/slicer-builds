+// Orca CLI: write the G-code thumbnails into a G-code file exported without them, where
+// GCode::_do_export writes them: after the header block, or first when there is none.
+static bool cli_insert_gcode_thumbnails(const std::string& gcode_path, const std::string& thumbnails)
+{
+    namespace fs = boost::filesystem;
+    const fs::path source(gcode_path);
+    boost::nowide::ifstream in(gcode_path, std::ios::binary);
+    if (!in.good())
+        return false;
+    std::string head(1 << 20, '\0');
+    in.read(head.data(), std::streamsize(head.size()));
+    head.resize(size_t(in.gcount()));
+    const std::string header_end = "; HEADER_BLOCK_END\n\n";
+    const size_t      found      = head.find(header_end);
+    const size_t      offset     = found == std::string::npos ? 0 : found + header_end.size();
+
+    const fs::path target = source.parent_path() / (source.filename().string() + ".thumbnails.tmp");
+    {
+        boost::nowide::ofstream out(target.string(), std::ios::binary | std::ios::trunc);
+        if (!out.good())
+            return false;
+        out.write(head.data(), std::streamsize(offset));
+        out.write(thumbnails.data(), std::streamsize(thumbnails.size()));
+        out.write(head.data() + offset, std::streamsize(head.size() - offset));
+        std::vector<char> buffer(1 << 20);
+        while (in.read(buffer.data(), std::streamsize(buffer.size())) || in.gcount() > 0)
+            out.write(buffer.data(), in.gcount());
+        if (!out.good())
+            return false;
+    }
+    in.close();
+    boost::system::error_code ec;
+    fs::rename(target, source, ec);
+    if (ec) {
+        fs::remove(target, ec);
+        return false;
+    }
+    return true;
+}
